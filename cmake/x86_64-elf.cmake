set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{LAMIX_CROSS_ROOT})
  set(_cross_bin "$ENV{LAMIX_CROSS_ROOT}/bin")
  find_program(_gcc x86_64-elf-gcc PATHS "${_cross_bin}" NO_DEFAULT_PATH REQUIRED)
else()
  find_program(_gcc x86_64-elf-gcc REQUIRED)
  get_filename_component(_cross_bin "${_gcc}" DIRECTORY)
endif()
foreach(_language gcc g++)
  execute_process(COMMAND "${_cross_bin}/x86_64-elf-${_language}" -dumpmachine
    RESULT_VARIABLE _result OUTPUT_VARIABLE _target OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _result EQUAL 0 OR NOT _target STREQUAL "x86_64-elf")
    message(FATAL_ERROR "Compiler ${_language} phải có target x86_64-elf; không dùng compiler host")
  endif()
endforeach()
set(CMAKE_C_COMPILER "${_cross_bin}/x86_64-elf-gcc")
set(CMAKE_CXX_COMPILER "${_cross_bin}/x86_64-elf-g++")
set(CMAKE_AR "${_cross_bin}/x86_64-elf-ar")
set(CMAKE_RANLIB "${_cross_bin}/x86_64-elf-ranlib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
